LOOPER_HOST=127.0.0.1
LOOPER_PORT=8000
# Set both values below when remote Workers must survive API restarts.
# The URL must be reachable from every imported machine. Prefer HTTPS outside a trusted LAN.
# LOOPER_HOST=0.0.0.0
LOOPER_REMOTE_WORKER_API_URL=
# Encrypt successful SSH connection credentials locally and rebuild tunnels after restart.
LOOPER_REMEMBER_SSH_CREDENTIALS=true
# Cloud purchases default to the password below; keep the real value only in the ignored .env.
# Key-pair mode remains available when a developer supplies a local key at this path.
LOOPER_DEFAULT_SSH_USERNAME=root
LOOPER_DEFAULT_SSH_PORT=22
LOOPER_DEFAULT_SSH_AUTH_METHOD=password
LOOPER_DEFAULT_SSH_PRIVATE_KEY_PATH=deploy/ssh/Looper.pem
LOOPER_DEFAULT_SSH_PASSWORD=
LOOPER_DATA_DIR=.looper
LOOPER_DATABASE_URL=sqlite:///.looper/looper.db
LOOPER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOOPER_TRUSTED_HOSTS=127.0.0.1,localhost,testserver
LOOPER_LOCAL_WORKER_TOKEN=change-me-for-remote-use
LOOPER_MAX_ARTIFACT_BYTES=268435456
LOOPER_MAX_OUTPUT_BYTES=16777216

# Dynamic source interface discovery. Source snippets are sent to this DeepSeek endpoint.
LOOPER_DEEPSEEK_BASE_URL=https://api.deepseek.com
LOOPER_DEEPSEEK_API_KEY=
LOOPER_DEEPSEEK_MODEL=deepseek-v4-flash
LOOPER_SOURCE_DISCOVERY_MAX_ARCHIVE_BYTES=20971520
LOOPER_SOURCE_DISCOVERY_MAX_EXPANDED_BYTES=104857600
LOOPER_SOURCE_DISCOVERY_MAX_FILES=10000
LOOPER_SOURCE_DISCOVERY_MAX_TOOL_ROUNDS=32
LOOPER_SOURCE_DISCOVERY_MAX_OUTPUT_TOKENS=16384

# Multi-cloud catalog cache and quote lifetime
LOOPER_CLOUD_CATALOG_TTL_SECONDS=300
LOOPER_CLOUD_STALE_CACHE_SECONDS=86400
LOOPER_CLOUD_QUOTE_TTL_SECONDS=300

# Live purchase is fail-closed. Keep these values disabled during development.
LOOPER_LIVE_PURCHASE_ENABLED=false
LOOPER_LIVE_PURCHASE_PROVIDERS=
# Independent 32+ character bearer token entered through the operator key control.
LOOPER_OPERATOR_TOKEN=
LOOPER_PURCHASE_CONFIRMATION_SECRET=
LOOPER_PURCHASE_CONFIRMATION_SECONDS=1800
LOOPER_MAX_LIVE_HOURLY_AMOUNT=10

# Tencent Cloud CVM (explicit credentials only)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SESSION_TOKEN=

# Alibaba Cloud ECS
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=

# Volcengine ECS
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_SESSION_TOKEN=

# Baidu Intelligent Cloud BCC
BAIDU_BCE_ACCESS_KEY_ID=
BAIDU_BCE_SECRET_ACCESS_KEY=
BAIDU_BCE_SECURITY_TOKEN=
# BAIDU_BCC_REGIONS=[{"id":"bj","name":"Beijing"}]
# BAIDU_BCC_ENDPOINTS={"bj":"bcc.bj.baidubce.com"}
