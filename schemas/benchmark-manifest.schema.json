{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looper.dev/schemas/v1alpha1/benchmark-manifest.schema.json",
  "title": "Looper Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "looper.dev/v1alpha1" },
    "kind": { "const": "Benchmark" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "description": { "type": "string", "maxLength": 2000 },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "x-extensions": {
          "type": "object",
          "properties": {
            "diagnosticRecommendations": { "$ref": "#/$defs/diagnosticRecommendations" }
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "parameters", "workloads", "runtime", "metrics", "outputs"],
      "properties": {
        "trust": { "enum": ["trusted", "untrusted"] },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "workloads": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/workload" }
        },
        "adapter": { "$ref": "#/$defs/adapter" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "infrastructure": { "$ref": "#/$defs/infrastructure" },
        "audit": { "$ref": "#/$defs/auditPolicy" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/metric" }
        },
        "outputs": { "$ref": "#/$defs/outputs" },
        "x-extensions": { "type": "object" }
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "operator", "value"],
      "properties": {
        "parameter": { "type": "string" },
        "operator": { "enum": ["eq", "neq", "in", "not_in"] },
        "value": {}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["integer", "number", "categorical", "boolean"] },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "log": { "type": "boolean", "default": false },
        "choices": { "type": "array", "minItems": 1, "items": {} },
        "default": {},
        "when": { "$ref": "#/$defs/condition" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0, "default": 1 },
        "metadata": { "type": "object" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/workloadMetric" }
        }
      }
    },
    "workloadMetric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "direction": { "enum": ["minimize", "maximize", "none"] },
        "kind": { "enum": ["sample", "aggregate", "counter", "boolean"] },
        "required": { "type": "boolean" },
        "minimumSamples": { "type": "integer", "minimum": 1 },
        "description": { "type": "string", "maxLength": 500 },
        "presentation": { "$ref": "#/$defs/metricPresentation" }
      }
    },
    "machineCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "default", "maximum"],
      "properties": {
        "minimum": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "default": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maximum": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "cpuRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumLogicalCpus": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "minimumPhysicalCores": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "minimumSockets": { "type": "integer", "minimum": 1, "maximum": 128 },
        "minimumNumaNodes": { "type": "integer", "minimum": 1, "maximum": 128 },
        "requiredFlags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" }
        }
      }
    },
    "memoryRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumGiB": { "type": "number", "exclusiveMinimum": 0, "maximum": 1048576 },
        "minimumHugepageGiB": { "type": "number", "minimum": 0, "maximum": 1048576 }
      }
    },
    "acceleratorRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minimumCount"],
      "properties": {
        "kind": { "enum": ["gpu", "tpu", "npu", "fpga", "other"] },
        "vendors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "minimumCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "minimumMemoryGiBEach": { "type": "number", "exclusiveMinimum": 0, "maximum": 1048576 },
        "interconnects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["none", "pcie", "nvlink", "xgmi", "other"] }
        }
      }
    },
    "storageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumFreeGiB": { "type": "number", "exclusiveMinimum": 0, "maximum": 1073741824 },
        "media": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["memory", "local-ssd", "local-nvme", "block", "shared-filesystem", "object", "other"] }
        },
        "shared": { "type": "boolean" },
        "destructive": { "type": "boolean", "default": false }
      }
    },
    "networkRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumGbps": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "maximumRttMs": { "type": "number", "minimum": 0, "maximum": 60000 },
        "fabrics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["ethernet", "infiniband", "roce", "efa", "shared-memory", "other"] }
        },
        "rdmaRequired": { "type": "boolean", "default": false }
      }
    },
    "machineRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "osFamilies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["linux", "windows", "macos", "aix", "other"] }
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["x86_64", "aarch64", "ppc64le", "riscv64", "other"] }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "cpu": { "$ref": "#/$defs/cpuRequirements" },
        "memory": { "$ref": "#/$defs/memoryRequirements" },
        "accelerators": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceleratorRequirements" }
        },
        "storage": { "$ref": "#/$defs/storageRequirements" },
        "network": { "$ref": "#/$defs/networkRequirements" },
        "privileges": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["root", "perf", "systemd", "hugepages", "raw-device", "container-runtime", "fault-injection"] }
        },
        "software": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 120 },
              "versionConstraint": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    },
    "nodePlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coLocateWith": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "separateFrom": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "sameZone": { "type": "boolean", "default": true },
        "dedicated": { "type": "boolean", "default": true }
      }
    },
    "nodeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "count", "requirements"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "role": { "enum": ["target", "load-generator", "client", "server", "database", "service", "controller", "worker", "storage", "observer", "simulator"] },
        "count": { "$ref": "#/$defs/machineCount" },
        "includedInScore": { "type": "boolean", "default": true },
        "requirements": { "$ref": "#/$defs/machineRequirements" },
        "placement": { "$ref": "#/$defs/nodePlacement" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "infrastructureLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "purpose"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "target": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 200 },
        "protocol": { "type": "string", "maxLength": 80 },
        "minimumGbps": { "type": "number", "exclusiveMinimum": 0, "maximum": 100000 },
        "maximumRttMs": { "type": "number", "minimum": 0, "maximum": 60000 },
        "fabric": { "enum": ["ethernet", "infiniband", "roce", "efa", "shared-memory", "other"] },
        "rdmaRequired": { "type": "boolean", "default": false }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orchestration", "primaryNodeGroup", "nodeGroups"],
      "properties": {
        "orchestration": { "enum": ["adapter", "looper"] },
        "primaryNodeGroup": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "nodeGroups": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nodeGroup" }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/infrastructureLink" }
        },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "auditPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumRepeats", "referencePolicy", "environmentAxes", "requiredEvidence"],
      "properties": {
        "minimumRepeats": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "referencePolicy": { "enum": ["required", "recommended", "not-applicable"] },
        "environmentAxes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["machine", "day", "placement", "seed", "compiler", "runtime", "driver", "region", "zone", "network", "storage", "dataset"] }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["system-fingerprint", "raw-result", "log", "trace", "histogram", "profile", "topology", "cost", "energy"] }
        }
      }
    },
    "scenarioRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "kind": { "enum": ["target", "load-generator", "database", "service", "observer"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 1 },
        "co_located_with": { "type": ["string", "null"] },
        "included_in_score": { "type": "boolean", "default": true },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "scenarioGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "scope", "metric", "operator", "threshold"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "kind": { "enum": ["execution", "correctness", "safety", "slo", "resource", "statistical"] },
        "scope": { "enum": ["attempt", "evaluation", "candidate", "block", "target", "placement_pair", "study"] },
        "metric": { "type": ["string", "null"] },
        "operator": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte", "true", "false"] },
        "threshold": { "type": ["number", "boolean", "null"] },
        "hard": { "type": "boolean", "default": true },
        "message": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "goodputPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "committed_outcome": { "type": "string", "minLength": 1 },
        "excluded_outcomes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["abort", "deadlock", "rollback", "retry", "timeout", "error"] }
        },
        "maximum_error_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_abort_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximum_timeout_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "tailEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "minimum_samples", "required_statistics", "histogram_format", "timeout_accounting"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "minimum_samples": { "type": "integer", "minimum": 100 },
        "required_statistics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["p50", "p95", "p99", "p99.9", "maximum", "timeout"] }
        },
        "histogram_format": { "enum": ["hdr", "raw", "upstream-summary"] },
        "timeout_accounting": { "enum": ["separate", "deadline-latency"] }
      }
    },
    "loadSearch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "offered_load_metric", "unit"],
      "properties": {
        "type": { "const": "bracketed-binary" },
        "offered_load_metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "calibration_repeats": { "type": "integer", "minimum": 2, "maximum": 20 },
        "common_load_fractions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "initial_repeats": { "type": "integer", "minimum": 2, "maximum": 20 },
        "boundary_repeats": { "type": "integer", "minimum": 3, "maximum": 50 },
        "required_passes": { "type": "integer", "minimum": 2, "maximum": 50 },
        "resolution_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.25 },
        "minimum_effect_ratio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "maximum_adaptive_points": { "type": "integer", "minimum": 1, "maximum": 30 },
        "expansion_factor": { "type": "number", "exclusiveMinimum": 1, "maximum": 4 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "decision_question", "user_value", "workload_class", "topology", "roles", "primary_metric"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "decision_question": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "user_value": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "workload_class": { "type": "string", "minLength": 1, "maxLength": 120 },
        "topology": { "enum": ["single-node", "client-server", "multi-node", "closed-loop"] },
        "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioRole" } },
        "primary_metric": { "type": "string", "minLength": 1 },
        "slo_gates": { "type": "array", "items": { "$ref": "#/$defs/scenarioGate" } },
        "goodput": { "$ref": "#/$defs/goodputPolicy" },
        "tail_evidence": { "$ref": "#/$defs/tailEvidence" },
        "load_search": { "$ref": "#/$defs/loadSearch" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeoutSeconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "allowedExitCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "default": [0]
        },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "commands"],
      "properties": {
        "type": { "enum": ["local-process", "container", "benchexec"] },
        "image": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?@sha256:[0-9a-f]{64}$"
        },
        "engine": { "const": "docker", "default": "docker" },
        "networkMode": { "enum": ["none", "bridge"], "default": "none" },
        "workingDirectory": { "type": "string", "default": "." },
        "dependencyLockDigest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeDependency" }
        },
        "provisioning": { "$ref": "#/$defs/runtimeProvisioning" },
        "executionPolicy": { "$ref": "#/$defs/executionPolicy" },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "prepare": { "$ref": "#/$defs/command" },
            "warmup": { "$ref": "#/$defs/command" },
            "run": { "$ref": "#/$defs/command" },
            "normalize": { "$ref": "#/$defs/command" },
            "validate": { "$ref": "#/$defs/command" },
            "collect": { "$ref": "#/$defs/command" },
            "cleanup": { "$ref": "#/$defs/command" }
          }
        }
      }
    },
    "runtimeDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "digest", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "source": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "runtimeProvisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "hostCapabilities", "provides", "cacheKey"],
      "properties": {
        "mode": { "const": "managed" },
        "hostCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "cacheKey": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "requiresNetwork": { "type": "boolean", "default": false },
        "privilege": { "enum": ["none", "sudo"], "default": "none" }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "network", "storage", "environmentEvidence"],
      "properties": {
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cpuAffinity", "numaPolicy"],
          "properties": {
            "mode": { "enum": ["isolated-container", "host-agent"] },
            "cpuAffinity": { "enum": ["any", "required"] },
            "numaPolicy": { "enum": ["any", "single-node", "explicit"] }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowedHosts", "maxTransferBytes"],
          "properties": {
            "mode": { "enum": ["none", "restricted-egress"] },
            "allowedHosts": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9.-]+$" }
            },
            "maxTransferBytes": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "inputId", "destructive"],
          "properties": {
            "mode": { "enum": ["workspace", "bound-input"] },
            "inputId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9._-]*$" },
            "destructive": { "type": "boolean" },
            "minimumFreeBytes": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "environmentEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "requiredFields"],
          "properties": {
            "profile": { "const": "looper.system-fingerprint/v1alpha1" },
            "requiredFields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" }
            }
          }
        }
      }
    },
    "adapterInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "kind": {
          "enum": ["dataset", "artifact", "config", "endpoint", "secret", "device", "topology"]
        },
        "required": { "type": "boolean" },
        "mediaType": { "type": "string", "maxLength": 160 },
        "mountPath": { "type": "string", "pattern": "^/looper/input(?:/[a-zA-Z0-9._-]+)+$" },
        "digestRequired": { "type": "boolean", "default": false },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "executionModel", "primaryMetric", "requiredChecks", "inputs", "canonicalOutputs"],
      "properties": {
        "protocol": { "const": "looper-adapter/v1" },
        "executionModel": {
          "enum": ["batch-suite", "service-stack", "database", "storage", "network", "distributed", "accelerator", "custom"]
        },
        "primaryMetric": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" }
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/adapterInput" }
        },
        "canonicalOutputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics", "result"],
          "properties": {
            "metrics": { "const": "metrics.jsonl" },
            "result": { "const": "result.json" }
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "direction", "kind"],
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "direction": { "enum": ["minimize", "maximize", "none"] },
        "kind": { "enum": ["sample", "aggregate", "counter", "boolean"] },
        "required": { "type": "boolean", "default": false },
        "minimumSamples": { "type": "integer", "minimum": 1, "default": 1 },
        "description": { "type": "string", "maxLength": 500 },
        "presentation": { "$ref": "#/$defs/metricPresentation" }
      }
    },
    "metricPresentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "userDescription": { "type": "string", "maxLength": 1000 },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["primary_outcome", "hard_gate", "guardrail", "cost_efficiency", "stability", "diagnostic", "context"]
          }
        },
        "defaultVisibility": { "enum": ["summary", "detail", "expert", "hidden"] },
        "displayFormat": { "enum": ["number", "percent", "duration", "bytes", "throughput", "boolean"] },
        "displayPrecision": { "type": "integer", "minimum": 0 },
        "glossary": { "type": "string", "maxLength": 500 }
      }
    },
    "diagnosticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumSamples", "cvStable", "cvUnstable", "modeMinimumSamples"],
      "properties": {
        "minimumSamples": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "cvStable": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "cvUnstable": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 },
        "slowShareUnstable": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "outlierFenceK": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "modeMinimumSamples": { "type": "integer", "minimum": 8, "maximum": 1000 },
        "modeMinR2": { "type": "number", "minimum": 0, "maximum": 1 },
        "modeMinClusterShare": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.5 },
        "modeGapRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "skewThreshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "associationMinCorrelation": { "type": "number", "minimum": 0, "maximum": 1 },
        "associationMinLift": { "type": "number", "exclusiveMinimum": 1, "maximum": 100 },
        "attributionMinEtaSquared": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "diagnosticRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "when", "priority", "kind", "action", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
        "scope": { "enum": ["group", "study"] },
        "when": {
          "enum": [
            "stable", "warning", "unstable", "insufficient_evidence",
            "outlier_present", "multimodal", "missing_system_metrics",
            "gate_failure", "single_target", "no_comparison"
          ]
        },
        "workloadIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" }
        },
        "priority": { "enum": ["high", "medium", "low"] },
        "kind": { "enum": ["diagnostic", "retest", "data_collection"] },
        "action": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "diagnosticRecommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "policy", "rules"],
      "properties": {
        "enabled": { "type": "boolean" },
        "policy": { "$ref": "#/$defs/diagnosticPolicy" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnosticRule" }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxBytes", "artifacts"],
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 10737418240 },
        "maxMetricLines": { "type": "integer", "minimum": 1, "maximum": 10000000, "default": 100000 },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "required"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "enum": ["log", "trace", "result", "raw-result", "profile", "dataset", "histogram", "other"] },
              "mediaType": { "type": "string", "default": "application/octet-stream" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
