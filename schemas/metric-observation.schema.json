{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looper.dev/schemas/v1alpha1/metric-observation.schema.json",
  "title": "Looper Metric Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metric", "value", "unit", "phase"],
  "properties": {
    "schemaVersion": { "const": "v1alpha1" },
    "metric": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
    "value": { "type": ["number", "boolean"] },
    "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
    "phase": { "enum": ["warmup", "measurement", "validation", "cleanup"] },
    "workload": { "type": ["string", "null"] },
    "sampleIndex": { "type": ["integer", "null"], "minimum": 0 },
    "sampleCount": { "type": ["integer", "null"], "minimum": 1 },
    "statistic": {
      "enum": ["sample", "mean", "median", "p50", "p95", "p99", "p99.9", "maximum", "rate", "cvar99", "count", "boolean"],
      "default": "sample"
    },
    "timestamp": { "type": ["string", "null"] },
    "attributes": { "type": "object" }
  }
}
