{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looper.dev/schemas/v1alpha1/derived-metric.schema.json",
  "title": "Looper Derived Metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "metric", "value", "unit", "statistic", "analysisToolId",
    "analysisToolVersion", "analysisToolDigest", "analysisInputDigest",
    "parametersDigest", "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "v1alpha1" },
    "metric": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$" },
    "value": { "type": "number" },
    "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
    "statistic": {
      "enum": [
        "sample", "mean", "median", "p50", "p95", "p99", "p99.9", "maximum", "rate",
        "cvar99", "count", "boolean"
      ]
    },
    "analysisToolId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "analysisToolVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "analysisToolDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "analysisInputDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inputArtifactDigests": { "type": "array", "items": { "type": "string" } },
    "traceSetDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "attemptId": { "type": ["string", "null"] },
    "parameters": { "type": "object" },
    "parametersDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "minLength": 1, "maxLength": 48 }
  }
}
