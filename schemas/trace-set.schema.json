{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looper.dev/schemas/v1alpha1/trace-set.schema.json",
  "title": "Looper Trace Set Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "traceSetId", "format", "timeUnit", "clockDomain", "collector",
    "measurement", "stepBoundaryRule", "expectedRanks", "files", "complete", "missingRanks"
  ],
  "properties": {
    "schemaVersion": { "const": "v1alpha1" },
    "traceSetId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "attemptId": { "type": ["string", "null"] },
    "benchmarkId": { "type": ["string", "null"] },
    "workloadId": { "type": ["string", "null"] },
    "format": { "enum": ["pytorch-kineto", "xprof", "nsys", "looper-synthetic-json"] },
    "timeUnit": { "enum": ["nanosecond", "microsecond", "millisecond", "second"] },
    "clockDomain": { "type": "string", "minLength": 1, "maxLength": 80 },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "configDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "warmup": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["startStep", "endStep"],
      "properties": {
        "startStep": { "type": "integer", "minimum": 0 },
        "endStep": { "type": "integer", "minimum": 0 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startStep", "endStep"],
      "properties": {
        "startStep": { "type": "integer", "minimum": 0 },
        "endStep": { "type": "integer", "minimum": 0 }
      }
    },
    "stepBoundaryRule": { "type": "string", "minLength": 1, "maxLength": 500 },
    "expectedRanks": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "artifactDigest", "artifactName", "size"],
        "properties": {
          "rank": { "type": "integer", "minimum": 0 },
          "device": { "type": ["integer", "null"], "minimum": 0 },
          "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "artifactName": { "type": "string", "minLength": 1, "maxLength": 255 },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "complete": { "type": "boolean" },
    "missingRanks": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "captureOverheadRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "extensions": { "type": "object" }
  }
}
