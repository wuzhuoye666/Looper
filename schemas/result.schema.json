{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://looper.dev/schemas/v1alpha1/result.schema.json",
  "title": "Looper Attempt Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "checks", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "v1alpha1" },
    "status": { "enum": ["succeeded", "failed", "timed_out", "cancelled"] },
    "message": { "type": ["string", "null"], "maxLength": 4000 },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "scope", "kind"],
        "properties": {
          "id": { "type": "string" },
          "passed": { "type": "boolean" },
          "scope": { "enum": ["attempt", "evaluation", "candidate", "block", "target", "placement_pair", "study"] },
          "kind": { "enum": ["execution", "correctness", "safety", "slo", "resource", "statistical"] },
          "message": { "type": ["string", "null"] },
          "details": { "type": "object" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "mediaType"],
        "properties": {
          "path": { "type": "string" },
          "role": { "enum": ["log", "trace", "result", "profile", "dataset", "histogram", "other"] },
          "mediaType": { "type": "string" },
          "description": { "type": ["string", "null"] }
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
